<div
  id="contacto-background"
  class="bg-[radial-gradient(circle_at_top,rgba(245,202,11,0.22),transparent_38%),linear-gradient(180deg,#171b23_0%,#0d1016_100%)] py-12 sm:py-19"
>
  <CursorFollower />
  <section
    class="flex flex-col justify-center align-middle mx-auto max-w-7xl px-3 pb-6 sm:px-3 sm:pb-10 lg:px-19"
    id="contacto"
  >
    <div
      class="relative rounded-4xl w-full border border-[rgba(245,202,11,0.18)] bg-[linear-gradient(180deg,rgba(22,26,34,0.94),rgba(14,17,23,0.98))] p-5 text-white shadow-[0_26px_70px_rgba(0,0,0,0.32)] backdrop-blur sm:p-8"
    >
      <div
        id="follow"
        class="flex flex-col px-0 absolute inset-0 rounded-4xl bg-[radial-gradient(circle_at_top_right,rgba(245,202,11,0.16),transparent_32%),radial-gradient(circle_at_bottom_left,rgba(255,255,255,0.05),transparent_28%)] opacity-100"
      >
      </div>

