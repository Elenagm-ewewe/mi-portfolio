---
import Layout from "../layouts/Layout.astro";
import { contacto, traducciones, alltools, formacion } from "../content/content.ts";
import { Icon } from "astro-icon/components";
import CursorFollower from "../components/CursorFollower.astro";

const copy = traducciones.es;


---

<Layout>

<style>

.cara{
	  animation: float 10s ease-in-out infinite;
}

@keyframes float {
  0% {
	transform: translateY(0);
  }
  25% {
	transform: translateY(-10px);
  transform: translateX(-5px);
  rotate: 2deg;
  }

  50% {
	transform: translateY(0);
	transform: translateX(10px);
  }
  75% {
	transform: translateY(10px);
	transform: translateX(5px);
  rotate: -2deg;
  }

  100% {
	transform: translateY(0);
  }
}


</style>

  <main class="relative bg-(--color-background) w-screen overflow-hidden">
