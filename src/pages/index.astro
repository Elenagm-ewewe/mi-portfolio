<section
  class="p-6 pt-15 mx-auto px-6 pb-10 sm:px-8 lg:px-10 lg:max-w-7xl"
  id="about"
>

  <div class="mb-6 items-end justify-between gap-4">
    <div>
      <p
        class="text-sm font-semibold uppercase tracking-[0.35em] text-[--color-hover]"
        data-i18n="about.eyebrow"
      >
        {copy.about.eyebrow}
      </p>
      <h2
        class="mt-2 text-3xl font-semibold text-[--color-semiblack]"
        data-i18n="about.title"
      >
        {copy.about.title}
      </h2>
    </div>

    <p
      class="text-sm leading-7 text-[--color-semiblack]/80"
      data-i18n="about.description"
    >
      {copy.about.description}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 my-12 max-w-6xl mx-auto px-4">
    
    <div>
        <h3 class="text-xl font-bold uppercase tracking-wider text-(--color-accent) mb-6">Formación Académica</h3>
        <div class="space-y-6 border-l-2 border-gray-200 pl-4">
            
          {formacion.map((edu) => (
            <div class="relative">
                <div class="absolute -left-5.25 top-1.5 w-2.5 h-2.5 rounded-full bg-(--color-accent)"></div>
                <span class="text-sm text-gray-500 font-medium">{edu.periodo}</span>
                <h4 class="font-bold text-lg text-gray-800">{edu.titulo}</h4>
                <p class="text-gray-600 text-sm">{edu.instituto}</p>
            </div>
          ))
          }
            
        </div>
    </div>

    <div>
        <h3 class="text-xl font-bold uppercase tracking-wider text-(--color-accent) mb-6">Mi Filosofía</h3>
        <div class="space-y-4 text-gray-600">
            <p>
                Me apasiona el punto donde se cruzan el <strong>código limpio</strong> y la <strong>narrativa visual</strong>. No solo desarrollo la lógica de una aplicación, sino que entiendo cómo debe comportarse el color, el ritmo y el movimiento en la pantalla.
            </p>
            <p>
                Mi objetivo es crear experiencias web que no solo funcionen a la perfección con tecnologías como Angular, Vue o Astro, sino que además tengan un impacto visual profesional y cinematográfico.
            </p>
        </div>
    </div>

</div>

  <div class="flex flex-col gap-15">

      {alltools.map((cat) => (
        <div class="mt-6 flex flex-col gap-4 w-full justify-center items-center">
          <p class="text-lg font-semibold text-[--color-semiblack] uppercase">
            {cat.name}
          </p>
          <div
            class="grid grid-cols-3 justify-center gap-8 lg:flex flex-row flex-wrap"
          >
            {
              cat.tools.map((tech) => (
                <span class="flex flex-col items-center gap-2 rounded-full px-3 py-1 text-xs font-medium text-[--color-semiblack] hover:scale-110 transition-transform">
                  <Icon
                    name={tech.icon}
                    width="35"
                    height="35"
                    class="drop-shadow"
                  />
                  {tech.name}
                </span>
              ))
            }
          </div>
        </div>
      ))}

    </div>

    </div>
  </div>
</section>

 <section class="mx-auto w-full max-w-7xl px-6 pb-10 sm:px-8 lg:px-10" id="proyectos">
			<div class="mb-6 flex items-end justify-between gap-4">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.35em] text-[--color-hover]" data-i18n="projects.eyebrow">{copy.projects.eyebrow}</p>
					<h2 class="mt-2 text-3xl font-semibold text-[--color-semiblack]" data-i18n="projects.title">{copy.projects.title}</h2>
				</div>
			</div>

			<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
				{copy.projects.items.map((project, index) => (
					<article class="group rounded-[1.75rem] border border-white/80 bg-white/80 p-6 shadow-[0_18px_40px_rgba(32,37,48,0.08)] backdrop-blur transition hover:-translate-y-1 hover:shadow-[0_24px_48px_rgba(32,37,48,0.12)]">
						<div class="relative flex object-cover items-center justify-between gap-3 -mx-6 -mt-6 overflow-hidden rounded-t-[1.75rem]">
              <img src={project.photo} alt={project.title} class="w-full z-0"/>
							<p class="absolute p-2 rounded-full bg-(--color-accent) top-3 left-3 text-sm font-semibold uppercase tracking-[0.28em] text-white z-10 shadow-2xl">0{index + 1}</p>
						</div>
						<h3 class="mt-5 text-2xl font-semibold text-[--color-semiblack]" data-i18n={`projects.items.${index}.title`}>{project.title}</h3>
						<p class="mt-3 text-sm leading-7 text-[--color-semiblack]/75" data-i18n={`projects.items.${index}.description`}>{project.description}</p>
						<div class="mt-6 flex flex-wrap gap-2">
							{project.tags.map((tag) => (
								<span class="rounded-full border border-[rgba(32,37,48,0.1)] bg-[--color-grisclaro] px-3 py-1 text-xs font-medium text-[--color-semiblack]">{tag}</span>
							))}
						</div>
					</article>
				))}
			</div>
