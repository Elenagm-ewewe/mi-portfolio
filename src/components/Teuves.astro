---

---

<div class="w-full grid grid-cols-1 sm:grid-cols-[1fr_2fr]  items-center justify-center gap-4">
  <div data-aos="fade-up" data-aos-duration="1500" class="sm:-mr-8 order-2 sm:order-1">
    <span
      class="text-6xl sm:text-7xl lg:text-9xl uppercase bg-linear-to-r from-(--color-semiblack) to-(--color-accent) bg-clip-text font-extrabold text-transparent"
      >SE TRATA DE CONTAR</span
    >

    <div class="flex flex-row pt-3">
      <div class="w-5 h-15 bg-(--color-accent) mr-2"></div>

      <p
        class="uppercase font-extralight text-gray-500 text-xl sm:text-lg lg:text-xl"
      >
        Diseño, vídeo y narrativa para marcas con identidad
      </p>
    </div>
  </div>

  <div class="w-full flex flex-col items-center justify-center min-w-[270px] order-1 sm:order-2">
    <div
      data-aos="fade-up"
      data-aos-duration="1500"
      class="max-w-[400px] mr-5 sm:mr-10 md:mr-20 -my-15 md:-my-20"
    >
      <video
        muted
        autoplay
        loop
        playsinline
        class="w-full animation-girito2 hover:scale-107 transition duration-200"
      >
        <source src="/videos/tv1.webm" type="video/webm" />
      </video>
    </div>

    <div
      data-aos="fade-up"
      data-aos-duration="2500"
      class="max-w-[400px] ml-5 sm:ml-10 md:ml-20 -my-15 md:-my-20"
    >
      <video
        muted
        autoplay
        playsinline
        loop
        class="w-full animation-girito hover:scale-107 transition duration-300"
      >
        <source src="/videos/tv3.webm" type="video/webm" />
      </video>
    </div>

    <div
      data-aos="fade-up"
      data-aos-duration="3000"
      class="max-w-[400px] mr-5 sm:mr-10 md:mr-20 -mt-15 md:-my-20"
    >
      <video
        muted
        autoplay
        playsinline
        loop
        class="w-full rotate-12 animation-girito hover:scale-107 transition duration-200"
      >
        <source src="/videos/tv2.webm" type="video/webm" />
      </video>
    </div>
  </div>
</div>
