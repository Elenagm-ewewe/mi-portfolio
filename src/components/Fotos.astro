---
const galeria = ["g1", "g2", "g3", "g4", "g5", "g6"];
---

<div  class="grid grid-cols-2 md:grid-cols-3 gap-2 w-full p-15 pt-15 mx-auto px-6 pb-10 sm:px-8 lg:px-10 lg:max-w-7xl">

    {galeria.map((foto) => (
        <div
        class="w-full h-full relative overflow-hidden"
        data-aos="fade-up" 
    data-aos-duration="1500"
        >
        <img
            src={`/images/galeria/${foto}.jpg`}
            alt={foto}
            class="w-full h-full object-cover transition duration-300 hover:scale-104"
        />
        </div>
    ))}


</div>